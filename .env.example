# Firebase Authentication
# Set to 'true' to enable Firebase authentication features
VITE_FIREBASE_AUTH_ENABLED=false

# Firebase Configuration (required when VITE_FIREBASE_AUTH_ENABLED=true)
# Get these values from your Firebase project console
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Cloudflare Worker Configuration
# URL of your deployed Cloudflare Worker for data persistence and published
# report permalinks (the "Publish report" action is hidden when unset)
VITE_CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev
# Data sync throttle interval in milliseconds (defaults to 60000 = 1 minute)
VITE_DATA_SYNC_THROTTLE_MS=60000

# CORS Proxy Configuration
# Optional proxy URL for bypassing CORS restrictions
# Uncomment and set to enable the proxy feature in the UI
# VITE_PROXY_URL=https://your-cors-proxy.workers.dev
# Hosted provider client IDs, client secrets, and the token-encryption key are
# Worker secrets. Never add them to this frontend environment file.

# Catalog submissions (/submit)
# The form posts to /api/catalog/submissions on the same origin, where the
# Worker route is mounted. Override it for local development against a deployed Worker.
# VITE_CATALOG_SUBMISSION_URL=https://your-worker.workers.dev/api/catalog/submissions
# Cloudflare Turnstile site key. Set it together with the Worker's TURNSTILE_SECRET;
# leave both unset to submit without a human check.
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Site assistant (solv.chat widget, src/siteAssistant/)
# The solv.chat Worker origin (https; it serves /widget.js and the chat API) and
# the assistant's public key. List this site in the assistant's allowed origins.
# Leave either unset and nothing is loaded or rendered, and the CSP is unchanged.
# VITE_SOLV_ENDPOINT=https://your-solv-chat.workers.dev
# VITE_SOLV_ASSISTANT_KEY=pk_your_public_key

# MCP server development page (/mcp-server-development, src/servicePage/)
# Off unless VITE_SERVICE_PAGE_ENABLED=true: no route, links, sitemap or routes.txt entry.
# VITE_SERVICE_API is the admin service's https base URL; the page reads
# <VITE_SERVICE_API>/public/offer (docs/service-offer-contract.md) and
# open_quote may only open <VITE_SERVICE_API>/q/<id>. The quote assistant is a
# second solv.chat assistant on VITE_SOLV_ENDPOINT, shown only on that page.
# VITE_SERVICE_PAGE_ENABLED=true
# VITE_SERVICE_API=https://service.example.com
# VITE_SOLV_QUOTE_ASSISTANT_KEY=pk_your_quote_assistant_key

# Server Configuration
# Port for the Express server (defaults to 3000 if not set)
PORT=3000
