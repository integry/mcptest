{
  "name": "mcp-sse-tester",
  "version": "1.0.0",
  "description": "Browser-based tester and catalog for remote MCP servers",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/generate-version.js",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate-catalog": "node scripts/validate-catalog.js",
    "build:workers": "npm --prefix cors-proxy-worker run build && npm --prefix cloudflare-worker run build",
    "prebuild": "node scripts/generate-version.js",
    "build": "npm run typecheck && vite build && npm run generate-seo",
    "generate-seo": "node scripts/generate-seo-pages.js",
    "deploy-worker": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "firebase": "^12.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "use-debounce": "^10.1.1",
    "uuid": "^11.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.120.0"
  }
}
