{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcptest.io/schemas/tool-selection-eval/v1.schema.json",
  "title": "mcptest tool-selection evaluation dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "descriptionRevision", "schemaRevision", "tools", "cases"],
  "properties": {
    "version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "descriptionRevision": { "type": "string", "minLength": 1 },
    "schemaRevision": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "#/$defs/suggestion" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "inputSchema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator"],
      "properties": {
        "tool": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": ["equals", "notEquals", "present", "absent", "type", "matches", "includes"]
        },
        "value": true
      },
      "allOf": [
        {
          "if": {
            "properties": { "operator": { "not": { "enum": ["present", "absent"] } } },
            "required": ["operator"]
          },
          "then": { "required": ["value"] }
        }
      ]
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": {
        "name": { "type": "string" },
        "arguments": true,
        "result": true
      }
    },
    "fixtureOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolCalls": { "type": "array", "items": { "$ref": "#/$defs/toolCall" } },
        "finalAnswer": { "type": "string" },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "caseBase": {
      "type": "object",
      "required": ["id", "prompt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "acceptableTools": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "forbiddenTools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "expectedNoTool": { "type": "boolean" },
        "argumentAssertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "notes": { "type": "string" },
        "toolReturnedData": true,
        "expectedFigures": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "fixture": {
          "oneOf": [
            { "$ref": "#/$defs/fixtureOutput" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fixtureOutput" } }
          ]
        }
      },
      "oneOf": [
        { "required": ["acceptableTools"] },
        { "required": ["expectedNoTool"], "properties": { "expectedNoTool": { "const": true } } }
      ]
    },
    "case": {
      "allOf": [{ "$ref": "#/$defs/caseBase" }],
      "unevaluatedProperties": false
    },
    "suggestion": {
      "allOf": [
        { "$ref": "#/$defs/caseBase" },
        {
          "type": "object",
          "required": ["synthetic", "reviewStatus"],
          "properties": {
            "synthetic": { "const": true },
            "reviewStatus": { "enum": ["unreviewed", "approved", "rejected"] }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
