{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcptest.io/schemas/report/v1.schema.json",
  "title": "mcptest public evaluation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifactType",
    "schemaVersion",
    "generatedAt",
    "generator",
    "target",
    "provenance",
    "outcome",
    "score",
    "sections"
  ],
  "properties": {
    "$schema": { "const": "https://mcptest.io/schemas/report/v1.schema.json" },
    "artifactType": { "const": "mcptest.report" },
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": { "$ref": "#/$defs/generator" },
    "target": { "$ref": "#/$defs/target" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "score": {
      "oneOf": [
        { "$ref": "#/$defs/overallScore" },
        { "type": "null" }
      ]
    },
    "protocol": { "$ref": "#/$defs/protocol" },
    "transport": { "$ref": "#/$defs/transport" },
    "timings": { "$ref": "#/$defs/timings" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "scored" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "score": { "$ref": "#/$defs/overallScore" },
          "sections": {
            "items": {
              "properties": {
                "status": { "const": "evaluated" },
                "score": {
                  "properties": { "earned": { "type": "number" } },
                  "required": ["earned"]
                }
              },
              "required": ["status", "score"]
            }
          }
        }
      },
      "else": { "properties": { "score": { "type": "null" } } }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "properties": { "status": { "const": "authorization-required" } },
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "outcome": { "required": ["authorizationPrerequisite"] }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "not": { "required": ["authorizationPrerequisite"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "const": "mcptest" },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testedEndpoint"],
      "properties": {
        "testedEndpoint": { "type": "string", "minLength": 1 },
        "authenticationEndpoint": { "type": "string", "minLength": 1 },
        "negotiatedEndpoint": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "proxyUsed"],
      "properties": {
        "route": { "enum": ["direct", "authenticated-proxy", "unknown"] },
        "proxyUsed": { "type": ["boolean", "null"] },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route", "result"],
            "properties": {
              "route": { "enum": ["direct", "authenticated-proxy"] },
              "result": { "const": "failed" }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "route": { "const": "direct" },
            "proxyUsed": { "const": false }
          }
        },
        {
          "properties": {
            "route": { "const": "authenticated-proxy" },
            "proxyUsed": { "const": true }
          }
        },
        {
          "properties": {
            "route": { "const": "unknown" },
            "proxyUsed": { "type": "null" }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["scored", "authorization-required", "partial", "failed"] },
        "summary": { "type": "string", "minLength": 1 },
        "authorizationPrerequisite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "state", "message"],
          "properties": {
            "required": { "const": true },
            "state": { "const": "authorization-required" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "overallScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned", "maximum", "percentage"],
      "properties": {
        "earned": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "exclusiveMinimum": 0 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["era"],
      "properties": {
        "era": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "negotiationMs": { "type": "number", "minimum": 0 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "durationMs"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "durationMs": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "sectionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned", "maximum"],
      "properties": {
        "earned": { "type": ["number", "null"], "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "context": { "type": "string" },
        "metadata": {}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "status", "score", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "status": { "enum": ["evaluated", "partial", "failed", "skipped", "prerequisite"] },
        "score": { "$ref": "#/$defs/sectionScore" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "evaluated" }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "score": {
                "properties": { "earned": { "type": "number" } },
                "required": ["earned"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["failed", "skipped", "prerequisite"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "score": {
                "properties": { "earned": { "type": "null" } },
                "required": ["earned"]
              }
            }
          }
        }
      ]
    }
  }
}
