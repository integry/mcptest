{
  "name": "mcptest-cors-proxy",
  "version": "1.0.0",
  "description": "CORS proxy worker for MCP Test with caller-based rate limits",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run src/index.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "keywords": [
    "cloudflare-worker",
    "cors",
    "proxy",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  }
}
