# Production build settings that are safe to commit. Secrets never go here.
#
# Cloudflare Turnstile site key for the /submit form (public by design; the
# matching TURNSTILE_SECRET lives on the mcptest-io Worker). The form renders
# the widget only when this is set, and the Worker requires a token only when
# its secret is set, so the two must be configured together.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFjtQako0Pl3qyxz
