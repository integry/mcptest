# Production build settings that are safe to commit. Secrets never go here.
#
# Cloudflare Turnstile site key for the /submit form (public by design; the
# matching TURNSTILE_SECRET lives on the mcptest-io Worker). The form renders
# the widget only when this is set, and the Worker requires a token only when
# its secret is set, so the two must be configured together.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFjtQako0Pl3qyxz

# Site assistant (solv.chat widget, src/siteAssistant/). The assistant key is a
# public key, safe to commit; the assistant's allowed origins on solv.chat list
# mcptest.io. The build adds this origin to the CSP (script-src, connect-src)
# and the config meta tag to every page; widget.js loads only once a visitor
# presses the launcher. scripts/audit-site.test.mjs fails the build check when
# a page loses the config or the policy stops allowing the origin.
VITE_SOLV_ENDPOINT=https://app.solv.chat
VITE_SOLV_ASSISTANT_KEY=pk_yk0rwe2xop2ocmaj5bky
